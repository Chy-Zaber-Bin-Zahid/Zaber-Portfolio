---
import BlurFade from "@/components/BlurFade.astro";
import { ChevronRight } from "lucide-react";
import type { Post } from "@/lib/posts";
import { POSTS_PER_PAGE } from "@/lib/posts";

interface Props {
  posts: Post[];
  page: number;
  totalPages: number;
  totalPosts: number;
}

const { posts, page, totalPages, totalPosts } = Astro.props;
const BLUR_FADE_DELAY = 0.04;
const hasPreviousPage = page > 1;
const hasNextPage = page < totalPages;
const pageHref = (n: number) => (n === 1 ? "/blog" : `/blog/page/${n}`);
const pagerLink =
  "h-8 w-fit px-2 flex items-center justify-center text-sm border border-border rounded-lg hover:bg-accent/50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2";
const pagerDisabled =
  "h-8 w-fit px-2 flex items-center justify-center text-sm border border-border/60 rounded-lg text-muted-foreground cursor-not-allowed";
---

<section id="blog">
  <BlurFade delay={BLUR_FADE_DELAY}>
    <h1 class="text-2xl font-semibold tracking-tight mb-2">
      Blog{" "}
      <span class="ml-1 bg-card border border-border rounded-md px-2 py-1 text-muted-foreground text-sm">{totalPosts} posts</span>
    </h1>
    <p class="text-sm text-muted-foreground mb-8">My thoughts on software development, life, and more.</p>
  </BlurFade>

  {posts.length > 0 ? (
    <>
      <BlurFade delay={BLUR_FADE_DELAY * 2}>
        <div class="flex flex-col gap-5">
          {posts.map((post, id) => {
            const indexNumber = (page - 1) * POSTS_PER_PAGE + id + 1;
            return (
              <BlurFade delay={BLUR_FADE_DELAY * 3 + id * 0.05}>
                <a
                  class="flex items-start gap-x-2 group cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                  href={`/blog/${post.id}`}
                >
                  <span class="text-xs font-mono tabular-nums font-medium mt-[5px]">{String(indexNumber).padStart(2, "0")}.</span>
                  <div class="flex flex-col gap-y-2 flex-1">
                    <p class="tracking-tight text-lg font-medium">
                      <span class="group-hover:text-foreground transition-colors">
                        {post.data.title}
                        <ChevronRight className="ml-1 inline-block size-4 stroke-3 text-muted-foreground opacity-0 -translate-x-2 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden />
                      </span>
                    </p>
                    <p class="text-xs text-muted-foreground">{post.data.publishedAt}</p>
                  </div>
                </a>
              </BlurFade>
            );
          })}
        </div>
      </BlurFade>

      {totalPages > 1 && (
        <BlurFade delay={BLUR_FADE_DELAY * 4}>
          <div class="flex gap-3 flex-row items-center justify-between mt-8">
            <div class="text-sm text-muted-foreground">Page {page} of {totalPages}</div>
            <div class="flex gap-2 sm:justify-end">
              {hasPreviousPage ? (
                <a href={pageHref(page - 1)} class={pagerLink}>Previous</a>
              ) : (
                <span class={pagerDisabled} aria-disabled="true">Previous</span>
              )}
              {hasNextPage ? (
                <a href={pageHref(page + 1)} class={pagerLink}>Next</a>
              ) : (
                <span class={pagerDisabled} aria-disabled="true">Next</span>
              )}
            </div>
          </div>
        </BlurFade>
      )}
    </>
  ) : (
    <BlurFade delay={BLUR_FADE_DELAY * 2}>
      <div class="flex flex-col items-center justify-center py-12 px-4 border border-border rounded-xl">
        <p class="text-muted-foreground text-center">No blog posts yet. Check back soon!</p>
      </div>
    </BlurFade>
  )}
</section>
