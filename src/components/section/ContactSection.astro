---
import { FlickeringGrid } from "@/components/magicui/flickering-grid";
import { CalendarDays } from "lucide-react";
import { Icons } from "@/components/icons";
import { DATA } from "@/data/resume";

const whatsappHref = `https://wa.me/${DATA.contact.tel.replace(/[^\d]/g, "")}`;
const calLink = DATA.contact.calLink;
---

<div class="border rounded-xl p-10 relative">
  <div class="absolute -top-4 border bg-primary z-10 rounded-xl px-4 py-1 left-1/2 -translate-x-1/2">
    <span class="text-background text-sm font-medium">Contact</span>
  </div>
  <div class="absolute inset-0 top-0 left-0 right-0 h-1/2 rounded-xl overflow-hidden">
    <FlickeringGrid
      client:visible
      className="h-full w-full"
      squareSize={2}
      gridGap={2}
      style={{
        maskImage: "linear-gradient(to bottom, black, transparent)",
        WebkitMaskImage: "linear-gradient(to bottom, black, transparent)",
      }}
    />
  </div>
  <div class="relative flex flex-col items-center gap-6 text-center">
    <h2 class="text-4xl font-bold tracking-tighter sm:text-6xl">Get in touch</h2>
    <p class="mx-auto max-w-lg text-muted-foreground text-balance sm:text-lg">
      Building something, or stuck on something? Let's discuss it.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-2 w-full sm:w-auto">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-12 w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl bg-primary px-8 text-base font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        <Icons.whatsapp className="size-5" />
        WhatsApp
      </a>
      <button
        type="button"
        data-cal-trigger
        data-cal-slug={calLink}
        class="inline-flex h-12 w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl border border-border bg-background px-8 text-base font-medium text-foreground shadow-sm transition-colors hover:bg-accent cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        <CalendarDays className="size-5" aria-hidden />
        Let's talk
      </button>
    </div>
  </div>
</div>

<script>
  /**
   * Cal.com embed, loaded on first interaction with the "Let's talk" button
   * rather than on page load, so the third-party script (and its cookies)
   * never run for visitors who do not book. Opens the booking modal and
   * follows the site's light/dark theme.
   */
  type CalFn = ((...args: unknown[]) => void) & {
    loaded?: boolean;
    ns?: Record<string, CalFn>;
    q?: unknown[];
  };

  declare global {
    interface Window {
      Cal?: CalFn;
    }
  }

  const NAMESPACE = "lets-talk";
  let loading: Promise<CalFn> | null = null;

  function installStub(): CalFn {
    const w = window;
    if (w.Cal) return w.Cal;
    const cal = function (...args: unknown[]) {
      const api = function (...innerArgs: unknown[]) {
        (api as CalFn).q?.push(innerArgs);
      } as CalFn;
      const [action, ns] = args;
      if (action === "init" && ns && typeof ns === "string") {
        api.q = api.q ?? [];
        cal.ns = cal.ns ?? {};
        cal.ns[ns] = cal.ns[ns] ?? api;
        (api as CalFn).q?.push(args);
        return;
      }
      cal.q = cal.q ?? [];
      cal.q.push(args);
    } as CalFn;
    cal.q = [];
    cal.ns = {};
    cal.loaded = true;
    w.Cal = cal;
    return cal;
  }

  function currentTheme() {
    return document.documentElement.classList.contains("dark") ? "dark" : "light";
  }

  function loadCal(): Promise<CalFn> {
    if (loading) return loading;
    loading = new Promise((resolve, reject) => {
      const cal = installStub();
      const script = document.createElement("script");
      script.src = "https://app.cal.com/embed/embed.js";
      script.async = true;
      script.onload = () => resolve(cal);
      script.onerror = () => reject(new Error("Failed to load Cal.com embed"));
      document.head.appendChild(script);

      cal("init", NAMESPACE, { origin: "https://app.cal.com" });
      const ns = cal.ns?.[NAMESPACE];
      if (ns) {
        const applyTheme = () => {
          const theme = currentTheme();
          // `colorScheme` keeps the booking iframe's color-scheme in step with
          // the page; a mismatch makes browsers paint the iframe opaque white.
          ns("ui", { theme, colorScheme: theme, hideEventTypeDetails: false, layout: "month_view" });
        };
        applyTheme();
        new MutationObserver(applyTheme).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
      }
    });
    return loading;
  }

  /**
   * Safety net: the embed sets `overflow: hidden` on <body> while the modal
   * is open and restores it on close. If its close path is interrupted, the
   * page stays unscrollable, so restore it ourselves whenever the modal
   * reports "closed" or disappears.
   */
  function watchModalClose() {
    const restoreScroll = () => {
      if (document.body.style.overflow === "hidden") document.body.style.overflow = "";
    };
    const watchBox = (box: Element) => {
      new MutationObserver(() => {
        const state = box.getAttribute("state");
        // The embed hides a closed modal with `visibility: hidden` on the host.
        if (state === "closed" || state === "failed" || (box as HTMLElement).style.visibility === "hidden") {
          setTimeout(restoreScroll, 50);
        }
      }).observe(box, { attributes: true, attributeFilter: ["state", "style", "class"] });
    };
    document.querySelectorAll("cal-modal-box").forEach(watchBox);
    new MutationObserver((records) => {
      for (const record of records) {
        record.addedNodes.forEach((node) => {
          if (node instanceof Element && node.tagName === "CAL-MODAL-BOX") watchBox(node);
        });
        if (record.removedNodes.length && !document.querySelector("cal-modal-box")) restoreScroll();
      }
    }).observe(document.body, { childList: true });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setTimeout(restoreScroll, 300);
    });
  }

  const trigger = document.querySelector<HTMLButtonElement>("[data-cal-trigger]");
  if (trigger) {
    // Deliberately not `data-cal-link`: the embed auto-binds clicks on that
    // attribute and would open a second, stacked modal on every click.
    const calLink = trigger.dataset.calSlug ?? "";
    // Warm the embed when the visitor shows intent, so the click feels instant.
    const warm = () => void loadCal().catch(() => {});
    watchModalClose();
    trigger.addEventListener("pointerenter", warm, { once: true });
    trigger.addEventListener("focus", warm, { once: true });
    const modals = () => [...document.querySelectorAll<HTMLElement>("cal-modal-box")];
    const isShowing = (box: HTMLElement) => box.style.visibility !== "hidden";

    trigger.addEventListener("click", async () => {
      // Never stack modals: a second modal captures the scroll lock set by the
      // first and restores it on close, which leaves the page frozen.
      if (trigger.disabled || modals().some(isShowing)) return;
      trigger.disabled = true;
      try {
        const cal = await loadCal();
        const existing = modals().find((box) =>
          ["loaded", "reopened"].includes(box.getAttribute("state") ?? "")
        );
        if (existing) {
          // Reuse the already-loaded booking page through the embed's own
          // "reopened" state instead of building another modal.
          document.body.style.overflow = "hidden";
          existing.setAttribute("state", "reopened");
          return;
        }
        // Pass the theme in the modal config too, so the booking iframe is
        // requested in the right theme instead of waiting for a message.
        const theme = currentTheme();
        cal.ns?.[NAMESPACE]?.("modal", {
          calLink,
          config: { layout: "month_view", theme, "ui.color-scheme": theme },
        });
      } catch {
        window.open(`https://cal.com/${calLink}`, "_blank", "noopener");
      } finally {
        // Short cooldown so a double-click can't open a second modal.
        setTimeout(() => {
          trigger.disabled = false;
        }, 400);
      }
    });
  }
</script>
