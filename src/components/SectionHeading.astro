---
/** Centered pill + headline + blurb used by the Projects/Open Source/Recommendations sections. */
interface Props {
  pill: string;
  title: string;
  description: string;
}
const { pill, title, description } = Astro.props;
---

<div class="flex flex-col gap-y-4 items-center justify-center">
  <div class="flex items-center w-full">
    <div class="flex-1 h-px bg-linear-to-r from-transparent from-5% via-border via-95% to-transparent"></div>
    <div class="border bg-primary z-10 rounded-xl px-4 py-1">
      <span class="text-background text-sm font-medium">{pill}</span>
    </div>
    <div class="flex-1 h-px bg-linear-to-l from-transparent from-5% via-border via-95% to-transparent"></div>
  </div>
  <div class="flex flex-col gap-y-3 items-center justify-center">
    <h2 class="text-3xl font-bold tracking-tighter sm:text-4xl">{title}</h2>
    <p class="text-muted-foreground md:text-lg/relaxed lg:text-base/relaxed xl:text-lg/relaxed text-balance text-center">
      {description}
    </p>
  </div>
</div>
