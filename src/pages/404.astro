---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Home } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist or may have been moved.">
  <div class="min-h-[calc(100vh-12rem)] flex flex-col">
    <div class="flex-1 flex items-center justify-center p-8">
      <div class="flex flex-col items-center text-center max-w-md relative">
        <h1
          class="text-[200px] font-semibold font-mono bg-linear-to-b from-primary/30 to-secondary/10 text-transparent bg-clip-text absolute -top-40 left-1/2 -translate-x-1/2 mask-[linear-gradient(to_bottom,black,black_20%,transparent_80%)] tracking-tighter uppercase"
          style="-webkit-text-stroke: 3px color-mix(in oklch, var(--primary) 60%, transparent);"
        >
          404
        </h1>
        <h2 class="text-4xl tracking-tight font-semibold text-foreground mb-2">Page Not Found</h2>
        <p class="text-muted-foreground mb-8 text-balance tracking-tight font-medium">
          The page you're looking for doesn't exist or may have been moved.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/" class={cn(buttonVariants({ variant: "outline" }), "gap-2 cursor-pointer")}>
            <Home className="h-4 w-4" />
            Go to Home
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
