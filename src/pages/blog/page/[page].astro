---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogList from "@/components/BlogList.astro";
import { getSortedPosts, POSTS_PER_PAGE, type Post } from "@/lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        page,
        totalPages,
        totalPosts: posts.length,
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  posts: Post[];
  page: number;
  totalPages: number;
  totalPosts: number;
}

const { posts, page, totalPages, totalPosts } = Astro.props;
---

<BaseLayout
  title={`Blog · Page ${page}`}
  description="Thoughts on software development, life, and more."
  image="/blog/og.png"
>
  <BlogList posts={posts} page={page} totalPages={totalPages} totalPosts={totalPosts} />
</BaseLayout>
